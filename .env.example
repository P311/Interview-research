# Any OpenAI-compatible provider. Defaults to DeepSeek if unset.
JOBAGENT_LLM_API_KEY=
JOBAGENT_LLM_BASE_URL=https://api.deepseek.com
JOBAGENT_LLM_MODEL=deepseek-v4-flash

# https://tavily.com - used by company_search. Optional: that node just degrades
# gracefully to "unavailable" if this is unset.
TAVILY_API_KEY=
